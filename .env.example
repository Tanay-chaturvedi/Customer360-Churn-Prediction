# =============================================================================
# Customer360 – Example Environment Variables
# Copy this file to '.env' and update with your local configuration:
#   Copy-Item .env.example .env
# Note: Never commit your actual '.env' file containing real secrets to version control.
# =============================================================================

# MySQL Relational Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=customer360_db

# FastAPI Scoring Microservice Endpoint
API_URL=http://127.0.0.1:8000

# MLflow Experiment Tracking Configuration
MLFLOW_TRACKING_URI=sqlite:///mlflow/mlflow.db
